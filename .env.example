# Copy to .env for local builds.
#
# PUBLIC_PREVIEW=true  -> every page gets <meta name="robots" content="noindex, nofollow">,
#                          sitemap.xml is generated with zero indexable URLs, and no page emits a
#                          canonical tag pointing at production. Use this for ALL preview/staging
#                          builds, including this one.
# PUBLIC_PREVIEW=false -> production behavior: indexable, full sitemap, real canonicals.
#                          Only flip this for the actual production deploy, and only once the
#                          items in docs/LAUNCH_BLOCKERS.md are resolved or explicitly accepted.
PUBLIC_PREVIEW=true

# Mark 29 — gates the Consulting page's "Purchase" buttons (see
# src/components/PurchaseButton.astro). Unset (the default in every build
# this repo runs today) -> buttons render as a static "Contact to Purchase"
# link to /contact instead of a live Stripe Checkout flow; no fetch call
# exists in that state at all. Set this only after deploying
# workers/stripe-checkout/ (shared with alexandermathai.com/consulting —
# one Texas Movement Consulting practice, one checkout) to its real URL.
# PUBLIC_STRIPE_CHECKOUT_ENDPOINT=https://tmi-stripe-checkout.<your-subdomain>.workers.dev

# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are NOT set here — they are
# Cloudflare Worker secrets for workers/stripe-checkout/, set via
# `wrangler secret put`, never exposed to the Astro site's build or client
# bundle. See workers/stripe-checkout/README.md for the full deployment
# sequence, including creating the real Stripe Products/Prices first.
