---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import SignalFeed from "@/components/SignalFeed.astro";
import ConsultingCTA from "@/components/ConsultingCTA.astro";
import HeroProductCarousel from "@/components/HeroProductCarousel.astro";
import FounderBridge from "@/components/FounderBridge.astro";
import BlackOwnedBanner from "@/components/BlackOwnedBanner.astro";
import { pageTitle } from "@tmi/constants";
import { PROPERTIES, ECOSYSTEM_MAP, GENERAL_CONTACT } from "@/lib/site";

const title = pageTitle("tmi", "Systems for people who move");
const description =
  "Texas Movement International operates at the intersection of performance, culture, media, technology, and disciplined execution.";

// The full ecosystem map (core, founder layer, and every vertical, each with
// its Building/Private badge) lives on /lanes — this section is a shorter,
// consistent teaser of the same ECOSYSTEM_MAP data (src/lib/site.ts), never
// a second, independently-maintained list. Every entry here is
// non-interactive, same as /lanes: nothing is presented as live.
const verticals = ECOSYSTEM_MAP.filter((e) => e.group === "vertical");
const laneBadges = verticals.map((v) => PROPERTIES[v.key].label.toUpperCase()).join(" · ");

---

<Layout title={title} description={description} path="/">
  <main id="main">
    <!-- Hero -->
    <section class="section hero">
      <div class="wrap hero-inner">
        <div>
          <div class="hero-tagline">SYSTEMS FOR PEOPLE WHO MOVE.</div>
          <h1>Texas Movement International.</h1>
          <p class="hero-body">
            Texas Movement International operates at the intersection of performance, culture, media, technology, and disciplined execution. It is a systems company building infrastructure for founders, athletes, and cities.
          </p>
          <p class="hero-body">
            The company is not one product. It is a set of connected operating lanes — <a href="/lanes" style="border-bottom: 1px solid var(--ink); color: var(--ink);">see every lane, in full →</a> — that share one standard for how work gets done.
          </p>
          <div class="hero-note">{laneBadges}</div>
        </div>

        <aside class="hero-figure">
          <img
            src="/05_banner_header.png"
            alt="Texas Movement International ecosystem map"
            class="hero-banner"
            width="1280"
            height="720"
          />
          <div class="hero-grid">
            <div class="hero-node hero-node--source">
              <div class="hero-node-label">Intake</div>
              <div>FounderLink routes work to the right lane.</div>
            </div>
            <div class="hero-node">
              <div class="hero-node-label">Systems</div>
              <div>Consulting builds the operational scaffolding.</div>
            </div>
            <div class="hero-node hero-node--terminal">
              <div class="hero-node-label">Output</div>
              <div>Performance, Media, and HERO carry it into the world.</div>
            </div>
          </div>
          <div class="hero-caption">
            FIG. 01 — ECOSYSTEM UNDER LOAD · TEXAS MOVEMENT INTERNATIONAL
          </div>
        </aside>
      </div>
    </section>

    <!-- Mark 30 — $500 Black-Owned Business rebuild offer, immediately
         below the hero section per the owner's spec. See
         BlackOwnedBanner.astro for the governance/implementation context. -->
    <BlackOwnedBanner />

    <!-- Mark 28 — Consulting CTA + HERO product carousel, in that order,
         immediately after the hero section and above the "What we are
         building" teaser. See ConsultingCTA.astro and
         HeroProductCarousel.astro for the governance/implementation
         context. -->
    <ConsultingCTA />
    <HeroProductCarousel />

    <!-- Mark 30 — Founder Bridge: a real, owner-authorized cross-property
         link to alexandermathai.com, placed between the hero/revenue
         sections above and the ecosystem/lanes sections below. See
         FounderBridge.astro for the full governance note. -->
    <FounderBridge />

    <!-- What we are building -->
    <section id="building" class="section section--panel">
      <div class="wrap">
        <Eyebrow>WHAT WE ARE BUILDING</Eyebrow>
        <h2>A system, not a single product.</h2>
        <p>
          Each vertical does one clearly defined job and reports to the same operating standard. Consulting builds digital ecosystem strategy and brand architecture; Performance handles training and athletic development; Media documents the work; HERO is the consumer product lane; Distribution handles content and partnership infrastructure; Social is the public conversation layer. FounderLink, Health, and Reparations are intentionally private for now.
        </p>
        <p>
          Every vertical below is being built out deliberately, one at a time — named honestly rather than presented as available before it's ready. See the full <a href="/lanes" style="border-bottom: 1px solid var(--ink); color: var(--ink);">ecosystem map</a> for how it fits together.
        </p>
      </div>
    </section>

    <!-- Explore the ecosystem -->
    <section id="ecosystem" class="section">
      <div class="wrap">
        <Eyebrow>EXPLORE THE ECOSYSTEM</Eyebrow>
        <h2>Find your lane.</h2>
        <p>
          Nine verticals, none presented as live yet. Most are still being built; a few are
          intentionally private for now. Full detail, including the institutional core and founder
          layer, lives on the <a href="/lanes" style="border-bottom: 1px solid var(--ink); color: var(--ink);">ecosystem map</a>.
        </p>

        <div class="teaser-list">
          {verticals.map((v) => {
            const property = PROPERTIES[v.key];
            const statusText = v.badge === "private" ? "Restricted Access" : "Deployment Pending";
            return (
              <div class="teaser-item">
                <div class="division-label">{property.label}</div>
                <div class="ecosystem-name">{property.name}</div>
                <span class="division-status">{statusText}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <SignalFeed linkToMedia />

    <!-- Primary CTA — renders unconditionally (Mark 34, "Open the Doors"). -->
    <section id="contact" class="section section--tight">
      <div class="wrap contact-cta">
        <Eyebrow>CONTACT</Eyebrow>
        <a class="btn" href={GENERAL_CONTACT.href}>
          {GENERAL_CONTACT.label} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
