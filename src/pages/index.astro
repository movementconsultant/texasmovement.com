---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { pageTitle } from "@tmi/constants";
import { PROPERTIES, isLiveProperty, verifiedGeneralContact } from "@/lib/site";
import type { PropertyKey } from "@tmi/constants";

const title = pageTitle("tmi", "Systems for people who move");
const description =
  "Texas Movement International operates at the intersection of performance, culture, media, technology, and disciplined execution.";

// The full lane grid (with descriptions, live/building status) lives on
// /lanes — see DivisionCard.astro there for the canonical "building" card
// treatment this section's live/plain-text split is deliberately reusing.
// tmi (this site) and founder (a separate person's site, alexandermathai.com)
// are excluded here for the same reason /lanes excludes them from its grid.
const ECOSYSTEM_ORDER: readonly PropertyKey[] = [
  "consulting",
  "founderlink",
  "performance",
  "health",
  "hero",
  "media",
  "distribution",
  "reparations",
  "social",
];
const laneBadges = ECOSYSTEM_ORDER.map((k) => PROPERTIES[k].label.toUpperCase()).join(" · ");

// Conditional primary CTA. See src/lib/site.ts — verifiedGeneralContact()
// returns null until hello@texasmovement.com is added to VERIFIED_INBOXES,
// which only happens after a human confirms the mailbox is provisioned,
// receiving mail, and being monitored. Until then this is null and the
// section below renders nothing — no CTA, no placeholder, no disabled
// button. See docs/LAUNCH_BLOCKERS.md for the exact unblock steps.
const cta = verifiedGeneralContact();
---

<Layout title={title} description={description} path="/">
  <main id="main">
    <!-- Hero -->
    <section class="section hero">
      <div class="wrap hero-inner">
        <div>
          <div class="hero-tagline">SYSTEMS FOR PEOPLE WHO MOVE.</div>
          <h1>Texas Movement International.</h1>
          <p class="hero-body">
            Texas Movement International operates at the intersection of performance, culture, media, technology, and disciplined execution. It is a systems company building infrastructure for founders, athletes, and cities.
          </p>
          <p class="hero-body">
            The company is not one product. It is a set of connected operating lanes — <a href="/lanes" style="border-bottom: 1px solid var(--ink); color: var(--ink);">see every lane, in full →</a> — that share one standard for how work gets done.
          </p>
          <div class="hero-note">{laneBadges}</div>
        </div>

        <aside class="hero-figure">
          <img
            src="/05_banner_header.png"
            alt="Texas Movement International ecosystem map"
            class="hero-banner"
            width="1280"
            height="720"
          />
          <div class="hero-grid">
            <div class="hero-node hero-node--source">
              <div class="hero-node-label">Intake</div>
              <div>FounderLink routes work to the right lane.</div>
            </div>
            <div class="hero-node">
              <div class="hero-node-label">Systems</div>
              <div>Consulting builds the operational scaffolding.</div>
            </div>
            <div class="hero-node hero-node--terminal">
              <div class="hero-node-label">Output</div>
              <div>Performance, Media, and HERO carry it into the world.</div>
            </div>
          </div>
          <div class="hero-caption">
            FIG. 01 — ECOSYSTEM UNDER LOAD · TEXAS MOVEMENT INTERNATIONAL
          </div>
        </aside>
      </div>
    </section>

    <!-- What we are building -->
    <section id="building" class="section section--panel">
      <div class="wrap">
        <Eyebrow>WHAT WE ARE BUILDING</Eyebrow>
        <h2>A system, not a single product.</h2>
        <p>
          Each lane does one clearly defined job and reports to the same operating standard. Consulting builds systems and AI workflows for founders and operators; Performance and Health handle movement training, evaluation, and recovery education; Media documents the work and Distribution handles rights and platform operations; HERO is the retail and product lane; Reparations is a research and systems-design lane on economic repair; Social is the public events layer. FounderLink is the intake point that routes new work to whichever lane fits — or says plainly if there isn't one yet.
        </p>
        <p>
          Some of these lanes are live today. Others are still being built out, and are named honestly below rather than linked before they're ready.
        </p>
      </div>
    </section>

    <!-- Explore the ecosystem -->
    <section id="ecosystem" class="section">
      <div class="wrap">
        <Eyebrow>EXPLORE THE ECOSYSTEM</Eyebrow>
        <h2>Find your lane.</h2>
        <p>
          Live lanes link out directly below. Lanes still in development are named, not linked, until they're ready — the same rule the full <a href="/lanes" style="border-bottom: 1px solid var(--ink); color: var(--ink);">lane map</a> follows.
        </p>

        <div class="teaser-list">
          {ECOSYSTEM_ORDER.map((key) => {
            const property = PROPERTIES[key];
            const live = isLiveProperty(key);
            return live ? (
              <a class="teaser-item teaser-item--link" href={property.url}>
                <div class="division-label">{property.label}</div>
                <div class="ecosystem-name">{property.name} <span aria-hidden="true">→</span></div>
              </a>
            ) : (
              <div class="teaser-item">
                <div class="division-label">{property.label}</div>
                <div class="ecosystem-name">{property.name}</div>
                <span class="division-status">In development</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Primary CTA — present ONLY when hello@texasmovement.com is in
         VERIFIED_INBOXES (src/lib/site.ts). Absent means absent: no
         placeholder, no disabled-looking button. See
         docs/LAUNCH_BLOCKERS.md for the exact unblock steps. -->
    {cta && (
      <section id="contact" class="section section--tight">
        <div class="wrap contact-cta">
          <Eyebrow>CONTACT</Eyebrow>
          <a class="btn" href={cta.href}>
            {cta.label} <span class="arrow">→</span>
          </a>
        </div>
      </section>
    )}
  </main>
</Layout>
