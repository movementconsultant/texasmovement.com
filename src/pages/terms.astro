---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { pageTitle } from "@tmi/constants";
import { ORG } from "@tmi/constants";
import { PROPERTIES } from "@/lib/site";

const title = pageTitle("tmi", "Terms of Use");
const description =
  "Terms of use for Texas Movement International LLC and its properties. Full terms text has not been published yet.";
---

<Layout title={title} description={description} path="/terms">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>LEGAL</Eyebrow>
        <h1>Terms of Use.</h1>
        <p>
          This page is a placeholder. {ORG.legalName} has not yet published full terms of use for
          {PROPERTIES.tmi.domain} or its properties.
        </p>
        <div class="stub-note">
          Policy content pending. No terms-of-use text has been drafted, reviewed, or approved for
          publication as of this build. This is tracked as a launch blocker; see
          <code>docs/LAUNCH_BLOCKERS.md</code> in the repository.
        </div>
      </div>
    </section>
  </main>
</Layout>
