---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import PurchaseButton from "@/components/PurchaseButton.astro";
import KeynoteReferralLink from "@/components/KeynoteReferralLink.astro";
import { pageTitle } from "@tmi/constants";
import { hubRoute } from "@/lib/hub-routes";
import { CONSULTING_TIERS } from "@/lib/commerce/consultingTiers";

// Mark 29 — explicit owner policy amendment: real purchase functionality
// (Stripe Checkout) added to this page's three engagement tiers, alongside
// expanded copy. This is a further step on the same reconciliation Mark 28
// already established for this route: /consulting's own status/copy is
// kept truthful to what the page actually does, rather than left stale.
// See src/lib/commerce/consultingTiers.ts, src/components/PurchaseButton.astro,
// and workers/stripe-checkout/ for the full implementation record,
// including the disclosed gap that real Stripe Price IDs were never
// provided to this build (referenced only via env vars the owner fills in
// after creating the real Products in their own Stripe dashboard).
//
// Mark 31 — "Quiet Authority" scalpel pass. Added "Who It's For" fit/no-fit
// framing and a "How It Works" principles section; added a subtle
// secondary keynote/speaking referral link. No FAQ or Early Childhood AI
// Toolkit content ever existed anywhere in this repo's history to remove —
// verified against full git history across both this repo and
// alexandermathai.com before writing any of Mark 31 or this Mark.
//
// Mark 32 — "Quiet Authority" de-clutter pass. Pure subtraction + spacing,
// no new copy beyond the owner's own exact given lines:
//   - Removed the /ecosystem cross-link from the closing stub note — the
//     ecosystem is implied, not explicitly mapped on this page anymore
//     (also reflected in the nav: Ecosystem is no longer nav-eligible,
//     see src/lib/hub-routes.ts).
//   - Moved the keynote/speaking referral out of the main flow entirely:
//     it now stands alone as the very last element on the page, right
//     above the footer, using the owner's exact given copy ("For keynote
//     speaking and live engagements, visit AlexanderMathai.com →") in
//     place of Mark 31's own phrasing — see KeynoteReferralLink.astro.
//   - "How It Works" and "Engagement Tiers" converted from side-by-side
//     grids to single-column editorial lists (hard 1px top borders,
//     massive padding between items).
//   - Doubled padding-block on every major section (new scoped
//     .section--roomy / .section--roomy-tight modifiers below — these do
//     NOT touch the shared global .section/.section--tight rules other
//     pages still use).
//   - Tier price lines now render as a massive stark monospace number,
//     with the description below in the smaller muted sans-serif already
//     used elsewhere on this page.
// FAQ and Early Childhood AI Toolkit: confirmed (again) not present on
// this page or anywhere in this repo — nothing to cut on those two points.

const title = pageTitle("tmi", "Consulting");
const description =
  "Texas Movement Consulting builds AI-powered operating systems for founders and institutions. Diagnostic intake is open for qualified operators.";
const posture = hubRoute("/consulting")!.postureLabel!;

const whatYouGet = [
  "30-day diagnostic with prioritized systems roadmap",
  "Documented decision record that survives team changes",
  "AI workflow implementation with your team co-owning the build",
  "Ongoing operator support for founders who need systems stewardship",
];

const howItWorks = [
  "Systems before narrative",
  "Document the decisions",
  "Legally in-bounds",
  "Built for serious work",
];
---

<Layout title={title} description={description} path="/consulting">
  <main id="main">
    <section class="section section--tight section--roomy-tight">
      <div class="wrap">
        <Eyebrow>CONSULTING</Eyebrow>
        <h1>Texas Movement Consulting.</h1>
        <span class="division-status">{posture}</span>
        <p>
          Consulting is the advisory and systems capability lane of Texas Movement International:
          turning operational and technical expertise into repeatable, documented systems rather
          than one-off advice. Diagnostic intake is open for qualified operators — see below.
        </p>
        <ul class="check-list">
          {whatYouGet.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a class="btn" href="/contact">
          Request Diagnostic Brief <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <section class="section section--panel section--roomy">
      <div class="wrap">
        <Eyebrow>FOCUS AREAS</Eyebrow>
        <h2>Where this lane is headed.</h2>
        <p>
          The planned scope covers a small number of service areas, each still in a capability-
          framework stage rather than a packaged offer: AI and workflow strategy, digital ecosystem
          and web architecture, digital brand systems, and process automation. Each is intended to
          follow one neutral method — diagnose the real constraint, design a system for it, document
          the system, and only then measure it — rather than a generic engagement template.
        </p>
      </div>
    </section>

    <section class="section section--roomy" aria-labelledby="fit-heading">
      <div class="wrap">
        <Eyebrow>WHO THIS IS FOR</Eyebrow>
        <h2 id="fit-heading">Fit matters more than budget.</h2>
        <div class="fit-grid">
          <div class="fit-block">
            <p class="fit-label">Good fit</p>
            <p>
              Founder-led companies from 1–20 people — service businesses, clinics, agencies — with
              real revenue at stake and a named decision-maker ready to act on what the diagnostic
              finds.
            </p>
          </div>
          <div class="fit-block">
            <p class="fit-label">Not a fit</p>
            <p>
              Idea-stage projects, vague requests without a defined problem, or engagements without
              a single accountable owner on your side.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--panel section--roomy" aria-labelledby="how-heading">
      <div class="wrap">
        <Eyebrow>HOW IT WORKS</Eyebrow>
        <h2 id="how-heading">Four principles.</h2>
        <ul class="editorial-list principles-list">
          {howItWorks.map((item, i) => (
            <li>
              <span class="principle-index">{`0${i + 1}`}</span>
              <span class="principle-text">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="tiers" class="section section--roomy" aria-labelledby="tiers-heading">
      <div class="wrap">
        <Eyebrow>ENGAGEMENT TIERS</Eyebrow>
        <h2 id="tiers-heading">Three ways to work together.</h2>

        <div class="editorial-list tiers-list">
          <article aria-labelledby="tier-diagnostic-heading">
            <h3 id="tier-diagnostic-heading">Tier 1 · Diagnostic</h3>
            <p class="tier-price">{CONSULTING_TIERS[0].priceRange}</p>
            <p class="tier-price-note">One-time · 30 days</p>
            <p class="tier-summary">
              A structured, four-week engagement that turns undocumented operational knowledge into
              a prioritized systems roadmap.
            </p>
            <p class="tier-subhead">Weeks</p>
            <ul class="check-list">
              <li>Week 1: Stakeholder interviews and current-state mapping</li>
              <li>Week 2: Friction point identification and owner-dependence audit</li>
              <li>Week 3: Systems architecture and AI workflow opportunities</li>
              <li>Week 4: Prioritized roadmap with timelines, owners, and key decisions</li>
            </ul>
            <p class="tier-subhead">Deliverables</p>
            <ul class="check-list">
              <li>Current-state systems map (visual + written)</li>
              <li>Friction log with severity ratings</li>
              <li>Prioritized implementation roadmap</li>
              <li>Decision record template for ongoing use</li>
            </ul>
            <PurchaseButton tierId="diagnostic" tierName="Diagnostic" />
          </article>

          <article aria-labelledby="tier-systems-build-heading">
            <h3 id="tier-systems-build-heading">Tier 2 · Systems Build</h3>
            <p class="tier-price">{CONSULTING_TIERS[1].priceRange}</p>
            <p class="tier-price-note">Scoped project</p>
            <p class="tier-summary">
              Implementation of the roadmap: real systems built, tested, and documented alongside
              your team, not handed off as a slide deck.
            </p>
            <p class="tier-subhead">Sprints</p>
            <ul class="check-list">
              <li>2-4 implementation sprints (2 weeks each)</li>
              <li>AI workflow design and testing with your team</li>
              <li>Documentation that enables audit and adjustment</li>
              <li>Handoff training for your internal systems owner</li>
            </ul>
            <p class="tier-subhead">Typical Scope</p>
            <ul class="check-list">
              <li>Client intake and onboarding automation</li>
              <li>AI-assisted content production workflows</li>
              <li>Decision support systems for recurring choices</li>
              <li>Cross-team coordination and handoff protocols</li>
            </ul>
            <PurchaseButton tierId="systems-build" tierName="Systems Build" />
          </article>

          <article aria-labelledby="tier-retainer-heading">
            <h3 id="tier-retainer-heading">Tier 3 · Operator Retainer</h3>
            <p class="tier-price">{CONSULTING_TIERS[2].priceRange}</p>
            <p class="tier-price-note">3-month minimum</p>
            <p class="tier-summary">
              Ongoing systems stewardship for operators who need ongoing calibration, not a one-time
              engagement.
            </p>
            <p class="tier-subhead">Cadence</p>
            <ul class="check-list">
              <li>Weekly systems check-in (30-60 min)</li>
              <li>Async decision support via structured briefs</li>
              <li>Monthly systems audit and adjustment</li>
              <li>Quarterly strategic review and roadmap update</li>
            </ul>
            <p class="tier-subhead">Best For</p>
            <ul class="check-list">
              <li>Founders scaling past 10 people who need systems stewardship</li>
              <li>Operators managing multiple projects with competing priorities</li>
              <li>Teams implementing AI workflows who need ongoing calibration</li>
              <li>Companies preparing for funding, acquisition, or leadership transition</li>
            </ul>
            <PurchaseButton tierId="retainer" tierName="Operator Retainer" />
          </article>
        </div>
      </div>
    </section>

    <section class="section section--panel section--roomy">
      <div class="wrap">
        <div class="divisions-grid">
          <div class="division">
            <div class="division-label">FUTURE PROOF / CASE-STUDY MODULE</div>
            <div class="division-title">Not yet populated.</div>
            <p class="division-body">
              No client name, result, metric, or testimonial appears on this page. A real case study
              will only be added once one exists and is confirmed for publication.
            </p>
          </div>
        </div>
        <div class="stub-note">
          Pricing above reflects each tier's published range; the exact amount for a given
          engagement is confirmed before checkout. There is still no booking link, calendar, or
          availability statement on this page beyond the purchase and contact routes above.
        </div>
      </div>
    </section>

    <div class="keynote-referral-row">
      <div class="wrap">
        <KeynoteReferralLink />
      </div>
    </div>
  </main>
</Layout>

<style>
  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block: 14px;
    padding: 0;
  }

  .check-list li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding-left: 18px;
    position: relative;
  }

  .check-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--ink-soft);
  }

  /* Mark 32 — doubles the shared global .section (88px) / .section--tight
     (72px) padding-block for this page's major sections only. Scoped to
     this component by Astro (never a :global() rule), so it has zero
     effect on any other page still using the plain .section /
     .section--tight classes. */
  .section--roomy {
    padding-block: 176px;
  }

  .section--roomy-tight {
    padding-block: 144px;
  }

  .fit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    margin-top: 28px;
  }

  .fit-block p:not(.fit-label) {
    color: var(--ink-soft);
    line-height: 1.6;
    margin-top: 8px;
  }

  .fit-label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .fit-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* Mark 32 — the shared "single-column editorial list" pattern for both
     How It Works and Engagement Tiers: a hard top border on every item,
     a matching bottom border after the last, and generous padding so
     each item reads as its own quiet block rather than a crowded card. */
  .editorial-list {
    display: flex;
    flex-direction: column;
    margin-top: 32px;
  }

  .editorial-list > * {
    border-top: 1px solid var(--line-strong);
    padding-block: 56px;
  }

  .editorial-list > *:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .principles-list {
    list-style: none;
    padding: 0;
  }

  .principles-list li {
    display: flex;
    align-items: baseline;
    gap: 24px;
  }

  .principle-index {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    flex: none;
  }

  .principle-text {
    font-family: "IBM Plex Mono", monospace;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .tiers-list h3 {
    font-size: 1.2rem;
  }

  /* Massive, stark monospace price — the numbers are the visual anchor
     of each tier row, per the owner's exact typography-hierarchy spec. */
  .tier-price {
    font-family: "IBM Plex Mono", monospace;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-top: 12px;
  }

  .tier-price-note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  /* Muted sans-serif description, deliberately smaller and quieter than
     the price above it — no font-family override, so it inherits the
     page's default sans stack rather than the monospace used for labels
     and numbers. */
  .tier-summary {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin-top: 16px;
    max-width: 42rem;
  }

  .tier-subhead {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-top: 18px;
  }

  .keynote-referral-row {
    padding-block: 40px;
    border-top: 1px solid var(--line-strong);
  }
</style>
