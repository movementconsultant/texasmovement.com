---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import ConsultingEmailCta from "@/components/ConsultingEmailCta.astro";
import { pageTitle } from "@tmi/constants";
import { hubRoute } from "@/lib/hub-routes";
import { CONSULTING_TIERS } from "@/lib/commerce/consultingTiers";

// Mark 29 — explicit owner policy amendment: real purchase functionality
// (Stripe Checkout) added to this page's three engagement tiers, alongside
// expanded copy. See src/lib/commerce/consultingTiers.ts and
// workers/stripe-checkout/ for the commerce backend, still deployed and
// available (see hub-routes.ts) but no longer linked from this page.
//
// Mark 34 ("Open the Doors") — the owner's explicit "bare minimum
// regulation, frictionless intake" direction. The Stripe "Purchase [Tier]"
// buttons are replaced with plain "Email Us" mailto CTAs (see
// ConsultingEmailCta.astro) — real purchase functionality is still real,
// it's just gated by conversation instead of checkout. A new "Connected
// Lanes" section (real internal links, no external claims) replaces the
// old ecosystem cross-link that lived in the closing stub note. All
// copy below is either the owner's own already-approved text (the hero
// bullets, tier breakdowns) or real site navigation — no new marketing
// claims were invented for this pass.
//
// Disclosed gap: the owner's Mark 34 brief asked to "bring back" an
// "Early Childhood AI Toolkit" section and an FAQ section from "legacy
// HTML" content. No such content exists anywhere in this repo's git
// history (verified directly, again, before writing this file — see
// Mark 31's identical finding) or anywhere in this conversation. Rather
// than invent a product description and FAQ answers for a real business,
// both are left out of this pass. Paste the actual legacy source and
// they can be added for real.

const title = pageTitle("tmi", "Consulting");
const description =
  "Texas Movement Consulting builds AI-powered operating systems for founders and institutions. Diagnostic intake is open for qualified operators.";
const posture = hubRoute("/consulting")!.postureLabel!;

const whatYouGet = [
  "30-day diagnostic with prioritized systems roadmap",
  "Documented decision record that survives team changes",
  "AI workflow implementation with your team co-owning the build",
  "Ongoing operator support for founders who need systems stewardship",
];

const connectedLanes = [
  { label: "About", body: "How Texas Movement International operates.", href: "/about" },
  { label: "Ecosystem", body: "Every lane this consulting practice connects to.", href: "/ecosystem" },
  { label: "Media", body: "Documentation and signal from the work itself.", href: "/media" },
  { label: "Performance", body: "The training and movement lane.", href: "/performance" },
];
---

<Layout title={title} description={description} path="/consulting">
  <main id="main">
    <section class="section section--tight section--roomy">
      <div class="wrap">
        <Eyebrow>CONSULTING</Eyebrow>
        <h1>Texas Movement Consulting.</h1>
        <span class="division-status">{posture}</span>
        <p>
          Consulting is the advisory and systems capability lane of Texas Movement International:
          turning operational and technical expertise into repeatable, documented systems rather
          than one-off advice. Diagnostic intake is open — see below.
        </p>
        <ul class="check-list">
          {whatYouGet.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a class="btn" href="/contact">
          Request Diagnostic Brief <span class="arrow">→</span>
        </a>
      </div>
    </section>

    <section class="section section--panel section--roomy">
      <div class="wrap">
        <Eyebrow>FOCUS AREAS</Eyebrow>
        <h2>Where this lane is headed.</h2>
        <p>
          The planned scope covers a small number of service areas, each still in a capability-
          framework stage rather than a packaged offer: AI and workflow strategy, digital ecosystem
          and web architecture, digital brand systems, and process automation. Each is intended to
          follow one neutral method — diagnose the real constraint, design a system for it, document
          the system, and only then measure it — rather than a generic engagement template.
        </p>
      </div>
    </section>

    <section id="tiers" class="section section--roomy" aria-labelledby="tiers-heading">
      <div class="wrap">
        <Eyebrow>ENGAGEMENT TIERS</Eyebrow>
        <h2 id="tiers-heading">Three ways to work together.</h2>

        <div class="tiers-grid">
          <article class="tier-card" aria-labelledby="tier-diagnostic-heading">
            <h3 id="tier-diagnostic-heading">Tier 1 · Diagnostic</h3>
            <p class="tier-price">{CONSULTING_TIERS[0].priceRange}</p>
            <p class="tier-summary">
              A structured, four-week engagement that turns undocumented operational knowledge into
              a prioritized systems roadmap.
            </p>
            <ul class="check-list">
              <li>Week 1: Stakeholder interviews and current-state mapping</li>
              <li>Week 2: Friction point identification and owner-dependence audit</li>
              <li>Week 3: Systems architecture and AI workflow opportunities</li>
              <li>Week 4: Prioritized roadmap with timelines, owners, and key decisions</li>
            </ul>
            <p class="tier-subhead">Deliverables</p>
            <ul class="check-list">
              <li>Current-state systems map (visual + written)</li>
              <li>Friction log with severity ratings</li>
              <li>Prioritized implementation roadmap</li>
              <li>Decision record template for ongoing use</li>
            </ul>
            <ConsultingEmailCta label="Email Us" subject="Diagnostic — let's talk" />
          </article>

          <article class="tier-card" aria-labelledby="tier-systems-build-heading">
            <h3 id="tier-systems-build-heading">Tier 2 · Systems Build</h3>
            <p class="tier-price">{CONSULTING_TIERS[1].priceRange}</p>
            <p class="tier-summary">
              Implementation of the roadmap: real systems built, tested, and documented alongside
              your team, not handed off as a slide deck.
            </p>
            <ul class="check-list">
              <li>2-4 implementation sprints (2 weeks each)</li>
              <li>AI workflow design and testing with your team</li>
              <li>Documentation that enables audit and adjustment</li>
              <li>Handoff training for your internal systems owner</li>
            </ul>
            <p class="tier-subhead">Typical Scope</p>
            <ul class="check-list">
              <li>Client intake and onboarding automation</li>
              <li>AI-assisted content production workflows</li>
              <li>Decision support systems for recurring choices</li>
              <li>Cross-team coordination and handoff protocols</li>
            </ul>
            <ConsultingEmailCta label="Email Us" subject="Systems Build — let's talk" />
          </article>

          <article class="tier-card" aria-labelledby="tier-retainer-heading">
            <h3 id="tier-retainer-heading">Tier 3 · Operator Retainer</h3>
            <p class="tier-price">{CONSULTING_TIERS[2].priceRange}</p>
            <p class="tier-summary">
              Ongoing systems stewardship for operators who need ongoing calibration, not a one-time
              engagement.
            </p>
            <ul class="check-list">
              <li>Weekly systems check-in (30-60 min)</li>
              <li>Async decision support via structured briefs</li>
              <li>Monthly systems audit and adjustment</li>
              <li>Quarterly strategic review and roadmap update</li>
            </ul>
            <p class="tier-subhead">Best For</p>
            <ul class="check-list">
              <li>Founders scaling past 10 people who need systems stewardship</li>
              <li>Operators managing multiple projects with competing priorities</li>
              <li>Teams implementing AI workflows who need ongoing calibration</li>
              <li>Companies preparing for funding, acquisition, or leadership transition</li>
            </ul>
            <ConsultingEmailCta label="Get in Touch" subject="Operator Retainer — let's talk" />
          </article>
        </div>
        <p class="tiers-note">
          No booking link, calendar, or scheduling tool — email starts the conversation, and we
          answer.
        </p>
      </div>
    </section>

    <section class="section section--panel section--roomy" aria-labelledby="connected-lanes-heading">
      <div class="wrap">
        <Eyebrow>CONNECTED LANES</Eyebrow>
        <h2 id="connected-lanes-heading">Part of the wider ecosystem.</h2>
        <p>
          Consulting doesn't operate in isolation — it draws on and feeds the rest of Texas
          Movement International.
        </p>
        <div class="divisions-grid">
          {connectedLanes.map((lane) => (
            <div class="division">
              <div class="division-label">{lane.label}</div>
              <p class="division-body">{lane.body}</p>
              <div class="division-links">
                <a href={lane.href}>{lane.label} →</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--roomy">
      <div class="wrap">
        <div class="divisions-grid">
          <div class="division">
            <div class="division-label">FUTURE PROOF / CASE-STUDY MODULE</div>
            <div class="division-title">Not yet populated.</div>
            <p class="division-body">
              No client name, result, metric, or testimonial appears on this page. A real case study
              will only be added once one exists and is confirmed for publication.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .check-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block: 14px;
    padding: 0;
  }

  .check-list li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
    padding-left: 18px;
    position: relative;
  }

  .check-list li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--ink-soft);
  }

  /* Mark 34 — a more generous, inviting rhythm than the shared global
     .section (88px) / .section--tight (72px) padding-block, scoped to
     this page only (Astro scopes component <style> blocks automatically;
     this is not a :global() rule, so it has zero effect on any other
     page still using the plain classes). */
  .section--roomy {
    padding-block: 132px;
  }

  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 32px;
    margin-top: 24px;
  }

  .tiers-note {
    margin-top: 24px;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .tier-card {
    border: 1px solid var(--line-strong);
    padding: 28px;
    display: flex;
    flex-direction: column;
  }

  .tier-card h3 {
    font-size: 1.1rem;
  }

  .tier-price {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 4px;
  }

  .tier-summary {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-top: 10px;
  }

  .tier-subhead {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-top: 10px;
  }
</style>
