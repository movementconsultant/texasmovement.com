---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { pageTitle } from "@tmi/constants";
import { ORG } from "@tmi/constants";
import { PROPERTIES } from "@/lib/site";

const title = pageTitle("tmi", "Accessibility");
const description =
  "Accessibility statement for Texas Movement International LLC. Full statement text has not been published yet.";
---

<Layout title={title} description={description} path="/accessibility">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>LEGAL</Eyebrow>
        <h1>Accessibility.</h1>
        <p>
          {ORG.legalName} has not yet published a formal accessibility statement for
          {PROPERTIES.tmi.domain} or its properties. In the meantime: this build was made with
          accessibility as an explicit requirement — a skip-to-content link, a keyboard- and
          screen-reader-reachable mobile navigation menu, checked color contrast, and descriptive
          alt text on every meaningful image. It has not yet had a full manual or
          assistive-technology audit beyond an automated axe-core pass. If you hit a barrier, use
          the <a href="/contact">contact page</a> to let us know.
        </p>
      </div>
    </section>
  </main>
</Layout>
