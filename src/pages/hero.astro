---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import HeroProductCarousel from "@/components/HeroProductCarousel.astro";
import { pageTitle } from "@tmi/constants";
import { hubRoute } from "@/lib/hub-routes";

const title = pageTitle("tmi", "HERO");
const description =
  "HERO is Texas Movement International's consumer product lane. Its storefront, checkout, fulfillment, and account systems run entirely on Shopify — the catalog below is fetched from HERO's own public product feed at build time.";
const posture = hubRoute("/hero")!.postureLabel!;
---

<Layout title={title} description={description} path="/hero">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>HERO</Eyebrow>
        <h1>HERO.</h1>
        <span class="division-status">{posture}</span>
        <p>
          HERO is Texas Movement International's consumer product lane — footwear, apparel, and
          performance-oriented design. Its storefront domain is hero.texasmovement.com, and its
          checkout, fulfillment, policies, support channel, and account systems are hosted entirely
          on Shopify — nothing here processes a payment or handles personal data.
        </p>
        <div class="stub-note">
          The catalog below is fetched at build time from HERO's own public product feed and
          self-hosted — no product image on this page is loaded from Shopify's servers when you
          visit. Current pricing, availability, and checkout happen only on HERO's own storefront;
          each product card links there directly.
        </div>
      </div>
    </section>

    <HeroProductCarousel />
  </main>
</Layout>
