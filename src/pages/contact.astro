---
// src/pages/contact.astro
//
// Mark 18 — new route (no contact form existed on this site before this
// pass). Mirrors alexandermathai.com's src/pages/contact.astro pattern:
// accessible fields, honeypot, client-side-only validation, and a
// PUBLIC_CONTACT_ENDPOINT-gated fetch that stays fully inert unless that
// env var is set to a real, deployed Worker URL at build time. See
// docs/mark-18-contact-intake-implementation.md and
// workers/contact-intake/README.md for the backend + deployment story.
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { pageTitle } from "@tmi/constants";

const title = pageTitle("tmi", "Contact");
const description =
  "Start a conversation with Texas Movement International — consulting, media, partnership, or general inquiries.";

// Never a literal string here — Astro/Vite inline this at build time. Unset
// (the default in every build this repository runs) resolves to an empty
// string, which the client script below treats as "no live endpoint" and
// keeps the form fully inert, matching every build validated so far.
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
---

<Layout title={title} description={description} path="/contact">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>CONTACT</Eyebrow>
        <h1>Start a conversation.</h1>
        <p>
          Use this form for consulting inquiries, media or partnership conversations, and general
          questions about Texas Movement International. It is not a support inbox for any specific
          vertical.
        </p>
      </div>
    </section>

    <section class="section contact-section">
      <div class="wrap">
        <form id="contact-form" class="contact-form" novalidate onsubmit="return false;">
          <div class="form-field">
            <label for="field-name">Name <span aria-hidden="true">*</span></label>
            <input type="text" id="field-name" name="name" autocomplete="name" required aria-describedby="error-name" />
            <p class="form-error" id="error-name" role="alert" hidden></p>
          </div>

          <div class="form-field">
            <label for="field-email">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="field-email" name="email" autocomplete="email" required aria-describedby="error-email" />
            <p class="form-error" id="error-email" role="alert" hidden></p>
          </div>

          <div class="form-field">
            <label for="field-organization">Organization</label>
            <input type="text" id="field-organization" name="organization" autocomplete="organization" />
          </div>

          <div class="form-field">
            <label for="field-message">Brief / message <span aria-hidden="true">*</span></label>
            <textarea id="field-message" name="message" rows="5" required aria-describedby="error-message"></textarea>
            <p class="form-error" id="error-message" role="alert" hidden></p>
          </div>

          <!-- Honeypot: hidden from sighted and AT users, left open for bots. -->
          <div class="form-field form-field--honeypot" aria-hidden="true">
            <label for="field-hp">Leave this field blank</label>
            <input type="text" id="field-hp" name="hp_confirm" tabindex="-1" autocomplete="off" />
          </div>

          <p class="form-privacy">
            Submissions are for review only: no automated booking or scheduling, and no fixed
            response-time guarantee. See the <a href="/privacy">privacy page</a> for how data is
            handled.
          </p>

          <button type="submit" class="btn" id="contact-submit">Send inquiry</button>

          <div id="form-status" class="form-status stub-note" role="status" aria-live="polite" hidden></div>
        </form>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 34rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .form-field input,
  .form-field textarea {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 0.75em 0.9em;
    min-height: 44px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
  }

  .form-field textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .form-field input[aria-invalid="true"],
  .form-field textarea[aria-invalid="true"] {
    border-color: var(--tension);
  }

  .form-error {
    color: var(--tension);
    font-size: 0.85rem;
  }

  .form-field--honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .form-privacy {
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .form-status[data-tone="pending-integration"],
  .form-status[data-tone="error"] {
    border-color: var(--tension);
  }
</style>

<script define:vars={{ contactEndpoint }}>
  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("form-status");

  const requiredFields = [
    { id: "field-name", errorId: "error-name", message: "Enter your name." },
    {
      id: "field-email",
      errorId: "error-email",
      message: "Enter a valid email address.",
      validate: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
    },
    { id: "field-message", errorId: "error-message", message: "Enter a brief message." },
  ];

  function showFieldError(id, errorId, message) {
    const input = document.getElementById(id);
    const error = document.getElementById(errorId);
    if (!input || !error) return;
    if (message) {
      input.setAttribute("aria-invalid", "true");
      error.textContent = message;
      error.hidden = false;
    } else {
      input.removeAttribute("aria-invalid");
      error.hidden = true;
      error.textContent = "";
    }
  }

  function validate() {
    let valid = true;
    for (const field of requiredFields) {
      const el = document.getElementById(field.id);
      const value = el?.value.trim() ?? "";
      const passesCustom = field.validate ? field.validate(value) : value.length > 0;
      if (!passesCustom) {
        showFieldError(field.id, field.errorId, field.message);
        valid = false;
      } else {
        showFieldError(field.id, field.errorId, null);
      }
    }
    return valid;
  }

  function setStatus(message, tone) {
    if (!statusEl) return;
    statusEl.hidden = false;
    statusEl.dataset.tone = tone;
    statusEl.textContent = message;
    statusEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (statusEl) statusEl.hidden = true;

    const honeypot = document.getElementById("field-hp");
    if (honeypot?.value) {
      setStatus("Thanks — your inquiry has been received.", "success");
      form.reset();
      return;
    }

    if (!validate()) {
      const firstInvalid = form.querySelector('[aria-invalid="true"]');
      firstInvalid?.focus();
      setStatus("Please fix the highlighted fields and try again.", "error");
      return;
    }

    // No live endpoint configured in this build (contactEndpoint is an
    // empty string in every build this repository runs today) — this is
    // the only outcome a valid submission can reach. Nothing is sent,
    // stored, or promised. See docs/mark-18-contact-intake-implementation.md.
    if (!contactEndpoint) {
      setStatus(
        "This form isn't connected to a delivery service yet, so this inquiry can't be sent from this page right now.",
        "pending-integration",
      );
      return;
    }

    const submitButton = document.getElementById("contact-submit");
    if (submitButton) submitButton.disabled = true;
    setStatus("Sending…", "pending-integration");

    try {
      const response = await fetch(contactEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: document.getElementById("field-name")?.value ?? "",
          email: document.getElementById("field-email")?.value ?? "",
          organization: document.getElementById("field-organization")?.value ?? "",
          message: document.getElementById("field-message")?.value ?? "",
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (response.ok && result.ok) {
        setStatus("Thanks — your inquiry has been received.", "success");
        form.reset();
      } else {
        setStatus(result.error || "Something went wrong. Please try again.", "error");
      }
    } catch {
      setStatus("Something went wrong. Please try again.", "error");
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
