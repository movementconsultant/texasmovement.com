---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import MediaGrid from "@/components/media/MediaGrid.astro";
import { pageTitle } from "@tmi/constants";
import { hubRoute } from "@/lib/hub-routes";
import { getCollection } from "astro:content";

const title = pageTitle("tmi", "Media");
const description =
  "Texas Movement Media's editorial index shows structural placeholder records pending owner review. Building — not yet live. No external destination, date, or media is published or verified yet.";
const posture = hubRoute("/media")!.postureLabel!;

// Fixed display order matching the Mark 9 seed order (TMM, then TMI, then
// founder/AVM) rather than relying on the content loader's filesystem order.
const DISPLAY_ORDER = [
  "tmm-youtube-placeholder",
  "tmi-substack-placeholder",
  "founder-short-form-placeholder",
];
const allMediaEntries = await getCollection("media");
const mediaEntries = DISPLAY_ORDER.map((id) => allMediaEntries.find((e) => e.id === id)).filter(
  (e) => e !== undefined,
);
---

<Layout title={title} description={description} path="/media">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>MEDIA</Eyebrow>
        <h1>Texas Movement Media.</h1>
        <span class="division-status">{posture}</span>
        <p>
          Media is the future editorial and documentation lane of Texas Movement International —
          the part of the ecosystem responsible for recording and explaining the work, not
          performing it. The publishing architecture below is a plan, not a live channel directory.
        </p>
      </div>
    </section>

    <section class="section section--panel">
      <div class="wrap">
        <Eyebrow>PLANNED PROGRAMMING</Eyebrow>
        <h2>Where this lane is headed.</h2>
        <p>
          Planned programming categories, all still concepts rather than a published schedule:
          sports and performance culture, systems and founder-perspective commentary, and
          behind-the-build documentation of the rest of the ecosystem. Any future series or playlist
          concept referenced from this site will be explicitly marked planned until it exists.
        </p>
        <div class="divisions-grid">
          <div class="division">
            <div class="division-label">PLACEHOLDER MODULE</div>
            <div class="division-title">Programming architecture — not yet built.</div>
            <p class="division-body">
              No view count, subscriber figure, platform link, channel link, or embedded video
              appears on this page. Nothing here should be read as a statement that programming is
              currently active.
            </p>
          </div>
        </div>
        <div class="stub-note">
          There is no newsletter signup, sponsorship solicitation, or contact route on this page.
          See the <a href="/ecosystem">ecosystem overview</a> for how this lane fits into the rest
          of Texas Movement International.
        </div>
      </div>
    </section>

    <section id="records" class="section">
      <div class="wrap">
        <Eyebrow>EDITORIAL INDEX RECORDS</Eyebrow>
        <h2>Structural placeholders, pending owner review.</h2>
        <p>
          This index uses owner-review media records. External destinations, rights, source
          metadata, accessibility materials, and editorial status are enabled only when
          individually reviewed. Texas Movement Media is an editorial and media-distribution
          function within Texas Movement International — not a separate platform, outlet,
          channel, publisher, account, domain, or feed service.
        </p>
        <MediaGrid entries={mediaEntries} />
        <div class="stub-note">
          Every record above is a structural placeholder: it is not linked to an external
          platform, and it must not be treated as current, verified, or active media. See
          docs/internal/mark-9-media-placeholder-owner-update-guide.md (repository documentation,
          not published on this site) for how each record can later be replaced with real,
          reviewed material.
        </div>
      </div>
    </section>
  </main>
</Layout>
