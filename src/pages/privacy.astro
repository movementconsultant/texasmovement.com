---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { pageTitle } from "@tmi/constants";
import { ORG } from "@tmi/constants";
import { PROPERTIES } from "@/lib/site";

const title = pageTitle("tmi", "Privacy Policy");
const description =
  "Privacy policy for Texas Movement International LLC and its properties. Full policy text has not been published yet.";
---

<Layout title={title} description={description} path="/privacy">
  <main id="main">
    <section class="section section--tight">
      <div class="wrap">
        <Eyebrow>LEGAL</Eyebrow>
        <h1>Privacy Policy.</h1>
        <p>
          {ORG.legalName} has not yet published a full privacy policy for {PROPERTIES.tmi.domain}
          or its properties. Full text is in progress. See the footer on any page for the current
          bare-minimum compliance line.
        </p>
      </div>
    </section>
  </main>
</Layout>
