---
// src/components/media/MediaPreviewArt.astro
//
// Mark 11 — a privacy-safe, static visual preview for one destination
// card. Entirely local: inline SVG geometry plus a typographic monogram
// derived from the source label, tinted per source class using this
// site's own two existing accent tokens (--compression, --tension) — never
// a platform brand color, a fetched logo, a remote thumbnail, or anything
// resembling a real video frame, article headline, or profile screenshot.
// Purely decorative (aria-hidden): the accessible source identity is
// rendered as real text elsewhere in the card.
interface Props {
  sourceClass: string;
  sourceLabel: string;
}

const { sourceClass, sourceLabel } = Astro.props;

function monogramFor(label: string): string {
  const letters = label
    .split(/\s+/)
    .filter(Boolean)
    .map((word) => word[0]!.toUpperCase())
    .join("");
  return (letters || "TM").slice(0, 3);
}

const monogram = monogramFor(sourceLabel);

const toneClass =
  sourceClass === "TMM"
    ? "media-preview-art--tmm"
    : sourceClass === "founder-AVM"
      ? "media-preview-art--founder"
      : "media-preview-art--tmi";
---

<div class={`media-preview-art ${toneClass}`} aria-hidden="true">
  <svg viewBox="0 0 64 64" role="presentation" focusable="false">
    <rect x="3" y="3" width="58" height="58" rx="3" class="media-preview-art-frame"></rect>
    <line x1="3" y1="24" x2="61" y2="24" class="media-preview-art-line"></line>
    <line x1="3" y1="44" x2="61" y2="44" class="media-preview-art-line"></line>
  </svg>
  <span class="media-preview-art-monogram">{monogram}</span>
</div>
