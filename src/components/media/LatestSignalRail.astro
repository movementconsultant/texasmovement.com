---
// src/components/media/LatestSignalRail.astro
//
// The "Latest Signal" rail. Renders up to 4 recent YouTube videos across
// the two owner-confirmed TMM channels (title, date, link — no metric, no
// description) or a static fallback note when channel-ID resolution or the
// build-time fetch fails. Per the Mark 13/14 governance decision, these
// items are exempt from per-item G-M8 review as "Raw Telemetry,"
// conditional on the guardrails below and the visible disclosure. See
// docs/mark-13-latest-signal-implementation.md and
// src/lib/telemetry/youtubeSignal.ts.
//
// Mark 26 — explicit policy amendment: thumbnails are now authorized on
// this rail specifically. They are factual, source-derived imagery
// (fetched at build time from i.ytimg.com using the video ID already
// extracted from the confirmed Atom feed — see
// scripts/fetch-media-thumbnails.mjs, which runs as an npm "prebuild" step
// so the files exist in public/media-thumbnails/ before this component
// renders) — not invented or fabricated visuals, which is what the
// original "no thumbnail" guardrail existed to prevent. Self-hosted, never
// hotlinked: the rendered HTML never references youtube.com or
// i.ytimg.com, so no request leaks to YouTube on page load and the
// postbuild guard needs no external-URL exception. A video whose
// thumbnail fetch failed (or wasn't attempted, e.g. no network access at
// build time) renders the same static per-item placeholder it always
// would have — never a broken image icon. The "no platform embeds" rule
// (no iframes, no embedded players) is unchanged.
import { getLatestSignalItems, videoIdFromLink } from "@/lib/telemetry/youtubeSignal";
import { existsSync } from "node:fs";
import { join } from "node:path";

const result = await getLatestSignalItems();
const THUMB_DIR = join(process.cwd(), "public", "media-thumbnails");

function thumbnailSrc(link: string): string | null {
  const videoId = videoIdFromLink(link);
  if (!videoId) return null;
  return existsSync(join(THUMB_DIR, `${videoId}.jpg`)) ? `/media-thumbnails/${videoId}.jpg` : null;
}
---

<div class="latest-signal-rail">
  {
    result.status === "ok" ? (
      <>
        <p class="latest-signal-live">
          <span class="latest-signal-live-dot" aria-hidden="true"></span>
          Live telemetry
        </p>
        <ul class="latest-signal-list">
          {result.items.map((item) => {
            const thumb = thumbnailSrc(item.link);
            return (
              <li>
                {thumb ? (
                  <img
                    src={thumb}
                    width="168"
                    height="94"
                    loading="lazy"
                    alt={item.title}
                    class="latest-signal-thumb"
                  />
                ) : (
                  <span class="latest-signal-thumb latest-signal-thumb--placeholder" aria-hidden="true">
                    <span class="latest-signal-thumb-placeholder-text">{item.title}</span>
                  </span>
                )}
                <span class="latest-signal-meta">
                  <span class="latest-signal-channel">{item.channelLabel}</span>
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="latest-signal-title"
                  >
                    {item.title}
                  </a>
                  {item.publishedAt && (
                    <time class="latest-signal-date" datetime={item.publishedAt}>
                      {new Date(item.publishedAt).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  )}
                </span>
              </li>
            );
          })}
        </ul>
        <p class="latest-signal-disclosure">
          Automatically retrieved from YouTube at build time — not individually reviewed. See the
          confirmed channel destinations above for the source directly.
        </p>
      </>
    ) : (
      <div class="latest-signal-fallback">
        <p class="signal-lost-line">
          <span aria-hidden="true">&gt;</span> SIGNAL LOST // AWAITING RECONNECTION // ROUTING TO
          SOURCE
        </p>
        <p class="signal-lost-description">
          The Latest Signal automated index isn't available for this build. See the channel
          directly:
        </p>
        <a
          href="https://youtube.com/@texasmovementmedia"
          target="_blank"
          rel="noopener noreferrer"
          class="latest-signal-fallback-link"
        >
          Texas Movement Media on YouTube &rarr;
        </a>
      </div>
    )
  }
</div>

<style>
  .latest-signal-live {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .latest-signal-live-dot {
    width: 7px;
    height: 7px;
    background: var(--ff-accent-signal);
    flex-shrink: 0;
    animation: signal-heartbeat-dot 60s ease-in-out infinite;
  }

  .latest-signal-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
  }

  .latest-signal-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    animation: telemetry-card-load 0.5s ease-out both;
  }

  .latest-signal-list li:nth-child(1) {
    animation-delay: 0s;
  }
  .latest-signal-list li:nth-child(2) {
    animation-delay: 0.08s;
  }
  .latest-signal-list li:nth-child(3) {
    animation-delay: 0.16s;
  }
  .latest-signal-list li:nth-child(4) {
    animation-delay: 0.24s;
  }

  /* Mark 26 — thumbnail. Hard 1px border (this codebase's brutalist token
     for that is --line-strong, not a literal --border variable), 0px
     radius already inherited from the global `* { border-radius: 0 }`
     reset, no drop shadow. Grayscale at rest, full color on hover — a
     restrained way to show these are real source images without letting
     color compete with the Signal Green accent-restraint rule (this stays
     monochrome either way; only the photo's own colors change). */
  .latest-signal-thumb {
    width: 168px;
    height: 94px;
    flex-shrink: 0;
    border: 1px solid var(--line-strong);
    object-fit: cover;
    display: block;
    filter: grayscale(1);
    transition: filter 0.25s ease;
  }

  .latest-signal-list li:hover .latest-signal-thumb {
    filter: grayscale(0);
  }

  .latest-signal-thumb--placeholder {
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    text-align: center;
  }

  .latest-signal-thumb-placeholder-text {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .latest-signal-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-signal-thumb {
      transition: none;
    }
  }

  .latest-signal-channel {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .latest-signal-title {
    font-weight: 600;
    border-bottom: 1px solid transparent;
    text-decoration: none;
  }

  .latest-signal-title:hover {
    border-bottom-color: var(--ink);
  }

  .latest-signal-date {
    font-size: 0.8rem;
    color: var(--ink-soft);
    white-space: nowrap;
    margin-left: auto;
  }

  .latest-signal-disclosure {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-top: 10px;
  }

  /* Mark 25 — "Signal Lost" terminal state, matching AVM's LedgerRail /
     LiveSystemsRail treatment. Signal Green here extends the same "live
     telemetry indicator" allowance already used for the OK-state dot
     above — this is that indicator's degraded state, not new decorative
     accent usage. */
  .latest-signal-fallback {
    padding: 16px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .signal-lost-line {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--ff-accent-signal);
  }

  .signal-lost-description {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .latest-signal-fallback-link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    align-self: flex-start;
  }
</style>
