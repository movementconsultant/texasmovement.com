---
import { PROPERTIES } from "@/lib/site";
import { LEGAL_LINKS } from "@tmi/constants";

// Mark 32 — "Quiet Authority" de-clutter. The footer previously had a
// second, conditional <nav> for ECOSYSTEM_MAP's "live" properties (see
// liveFooterFor() in src/lib/site.ts) — always empty in every build this
// repository has run, since no ECOSYSTEM_MAP entry has ever been marked
// "live". That data-layer governance function is untouched (it still
// gates any FUTURE real ecosystem link, same as before), but this
// component no longer calls it: per the owner's exact Mark 32 spec, the
// footer now renders exactly five things, always — Texas Movement
// International, Alexander Mathai, Privacy, Terms, and the copyright
// line. Alexander Mathai's link is sourced from PROPERTIES.founder.url
// (status "live" — the same gate every other real outbound link on this
// site goes through), not hardcoded. "Accessibility" is dropped from the
// footer's own LEGAL_LINKS render (still a real route at /accessibility,
// just no longer footer-linked, per the same "leave the route intact,
// remove it from the surface" pattern used elsewhere in this Mark).
const legalLinks = LEGAL_LINKS.filter((l) => l.label !== "Accessibility");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-inner">
      <nav class="footer-nav" aria-label="Footer">
        <a href="/">{PROPERTIES.tmi.name}</a>
        <a href={PROPERTIES.founder.url} target="_blank" rel="noopener noreferrer">
          {PROPERTIES.founder.name}
        </a>
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <span class="footer-copyright">© {year} {PROPERTIES.tmi.name}</span>
    </div>
  </div>
</footer>
